# ===== Docker / host =====
PUID=1000
PGID=1000
TZ=Europe/Madrid

# Host paths (mounted as /config, /incoming and /temp in the container)
# AMULE_TEMP_DIR must be a dedicated directory: the entrypoint chowns it
# recursively, so pointing it at a shared one (the host's /tmp above all) would
# hand every file in it to PUID:PGID. Keep it on local disk, not on a network
# share: it holds the .part files and gets constant writes.
AMULE_CONFIG_DIR=./data/config
AMULE_INCOMING_DIR=./data/incoming
AMULE_TEMP_DIR=./data/temp

# ===== Build (which aMule source to compile) =====
# Git ref to build: a release tag (3.0.1) or a branch (master) to track the
# latest upstream code. Applies on `docker compose build`.
AMULE_VERSION=3.0.1
# Tag for the built image. Change it alongside AMULE_VERSION so a master build
# doesn't overwrite your 3.0.1 image (e.g. AMULE_IMAGE_TAG=master).
AMULE_IMAGE_TAG=3.0.1
# Upstream repository (amule-project/amule is frozen; amule-org is the live one)
#AMULE_REPO=https://github.com/amule-org/amule
# Only needed when AMULE_VERSION is a branch: the `git clone` layer is cached,
# so change this value (a date works) to force a rebuild from a fresh clone.
#AMULE_GIT_REFRESH=2026-08-27

# ===== aMule configuration (SECTION__KEY format -> [Section] Key=value) =====
# Any variable containing "__" is written to amule.conf on every start.
# Passwords are written here in plaintext; the entrypoint converts them to MD5.

# --- Required ---
# External Connections password (amuled <-> amuleweb/amulecmd/amulegui)
EXTERNALCONNECT__ECPASSWORD=changeme
# Web interface password
WEBSERVER__PASSWORD=changeme

# --- Main settings ---
EMULE__NICK=aMule docker
# ed2k TCP port (also used in the compose port mappings)
EMULE__PORT=4662
# UDP port (Kad and extended server requests)
EMULE__UDPPORT=4672
# Limits in kB/s (0 = unlimited)
EMULE__MAXUPLOAD=0
EMULE__MAXDOWNLOAD=0
EMULE__CONNECTTOED2K=1
EMULE__CONNECTTOKAD=1

# Web interface port (compose mapping + amuleweb's -s flag)
WEBSERVER__PORT=4711
# External Connections port
EXTERNALCONNECT__ECPORT=4712

# --- Download categories (optional) ---
# Each category needs TITLE and INCOMING (a path INSIDE the container) and
# they must be consecutive starting at 1. Optional: _COLOR, _PRIORITY, _COMMENT.
# The entrypoint creates the folder if it doesn't exist; if it points outside
# /incoming, mount the corresponding volume in docker-compose.yml.
# CATEGORY_1_TITLE=Movies
# CATEGORY_1_INCOMING=/incoming/movies
# CATEGORY_1_COLOR=0
# CATEGORY_2_TITLE=TV Shows
# CATEGORY_2_INCOMING=/incoming/tvshows
# CATEGORY_2_COLOR=1
# CATEGORY_3_TITLE=Music
# CATEGORY_3_INCOMING=/incoming/music
# CATEGORY_3_COLOR=2

# --- Optional: any other amule.conf key ---
# For keys not yet present in amule.conf use aMule's exact spelling
# (wxFileConfig is case-sensitive), e.g.:
# eMule__SmartIdCheck=1
# eMule__MaxConnections=500

# amuleweb template (installed in /usr/local/share/amule/webserver)
AMULEWEB_TEMPLATE=default
